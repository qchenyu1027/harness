# Robot extension: a single Chat Completions model for execution and improvement.
ROBOT_LLM_BASE_URL=http://192.168.100.212:8000/v1
ROBOT_LLM_MODEL=Qwen3.5-27B
ROBOT_LLM_API_KEY=
ROBOT_LLM_TIMEOUT_S=300

# Harness talks only to the local FastAPI tool gateway in real mode.
ROBOT_TOOL_API_BASE=http://127.0.0.1:8090
ROBOT_TOOL_API_KEY=
ROBOT_HEALTH_TIMEOUT_S=5
ROBOT_ACTION_TIMEOUT_S=600

# Optional upstream base-motion service used by the gateway's move_robot tool.
ROBOT_MOTION_API_BASE=
ROBOT_MOTION_API_KEY=

# RPent clothes grasp integration. It assumes the base is already at the calibrated clothes station.
RPENT_ROOT=/home/tjzn-zwt/Aqqqcy/github/RPent
RPENT_ROS_SETUP=/home/tjzn-zwt/Aqqqcy/github/harness/harness2/robot/config/luna_ros_env.sh
RPENT_PYTHON=/usr/bin/python3
RPENT_CLOTHES_TIMEOUT_S=600
RPENT_CLOTHES_GRIPPER_CLOSE_S=2
# Defaults are under harness/robot_runtime; override only when artifacts live elsewhere.
HARNESS_ROBOT_RUNTIME=/home/tjzn-zwt/Aqqqcy/github/harness/robot_runtime
LUNA_ROS_OVERLAY=/home/tjzn-zwt/Aqqqcy/github/harness/robot_runtime/luna_ros_overlay/install/setup.bash
LUNA_APEX_WORKSPACE=/home/tjzn-zwt/Aqqqcy/github/harness/robot_runtime/Apex_Deploy

# Original professional benchmarks still use their own settings:
# HARNESS2_SOLVER_MODEL=provider/model
# HARNESS2_IMPROVER_MODEL=provider/model
# HARNESS2_JUDGE_MODEL=judge-model
# GOOGLE_CLOUD_PROJECT=your-project
