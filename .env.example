# Robot extension: a single Chat Completions model for execution and improvement.
ROBOT_LLM_BASE_URL=http://10.121.40.31:8000/v1
ROBOT_LLM_MODEL=Qwen3.5-9B
ROBOT_LLM_API_KEY=
ROBOT_LLM_TIMEOUT_S=90

# Only used by an explicit `harness2-robot run --real` invocation.
# Set the actual robot server endpoint and key locally. Never commit the real key.
ROBOT_API_BASE=
ROBOT_API_KEY=
ROBOT_HEALTH_TIMEOUT_S=5
ROBOT_ACTION_TIMEOUT_S=600

# Original professional benchmarks still use their own settings:
# HARNESS2_SOLVER_MODEL=provider/model
# HARNESS2_IMPROVER_MODEL=provider/model
# HARNESS2_JUDGE_MODEL=judge-model
# GOOGLE_CLOUD_PROJECT=your-project
