{
  "tools": {
    "move_robot": {
      "description": "Move the base to one of the existing preset poses.",
      "kind": "http",
      "base_url_env": "ROBOT_MOTION_API_BASE",
      "api_key_env": "ROBOT_MOTION_API_KEY",
      "health_path": "/health",
      "execute_path": "/move",
      "cancel_path": "/cancel",
      "payload": {
        "pose_ids": ["$args.pose_id"]
      }
    },
    "grasp_clothes": {
      "description": "Run the configured RPent fixed-pose clothes grasp.",
      "kind": "process",
      "environment_script": "luna_ros_env.sh",
      "command": [
        "${RPENT_PYTHON}",
        "${RPENT_ROOT}/test.incoming_20261021/clothes_pose_sequence_test.py",
        "--execute",
        "--home-mode",
        "direct",
        "--gripper-side",
        "right",
        "--gripper-close-duration-s",
        "${RPENT_CLOTHES_GRIPPER_CLOSE_S}"
      ],
      "health_arguments": ["--help"],
      "timeout_env": "RPENT_CLOTHES_TIMEOUT_S"
    }
  }
}
